{
	"name": "DS_ADLS_DynamicSource",
	"properties": {
		"linkedServiceName": {
			"referenceName": "LS_ADLS_DataLake",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"p_SourceContainer": {
				"type": "string"
			},
			"p_SourcePathPattern": {
				"type": "string"
			},
			"p_FileName": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": "@dataset().p_FileName",
				"folderPath": "@dataset().p_SourcePathPattern",
				"fileSystem": "@dataset().p_SourceContainer"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	}
}