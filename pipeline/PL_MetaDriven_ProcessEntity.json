{
	"name": "PL_MetaDriven_ProcessEntity",
	"properties": {
		"activities": [
			{
				"name": "Copy_ADLS_to_SQL",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"additionalColumns": [
							{
								"name": "LoadTimestamp",
								"value": "@utcnow()"
							},
							{
								"name": "FileName",
								"value": "$$FILEPATH"
							}
						],
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "AzureSqlSink",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_ADLS_DynamicSource",
						"type": "DatasetReference",
						"parameters": {
							"p_SourceContainer": "@item().SourceContainer",
							"p_SourcePathPattern": "@pipeline().parameters.p_SourcePathPattern",
							"p_FileName": "@pipeline().parameters.p_FileName"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_SQL_DynamicTarget",
						"type": "DatasetReference",
						"parameters": {
							"p_StagingTable": "@last(split(pipeline().parameters.p_StagingTable,'.'))"
						}
					}
				]
			}
		],
		"parameters": {
			"p_EntityId": {
				"type": "int"
			},
			"p_EntityName": {
				"type": "string"
			},
			"p_SourceContainer": {
				"type": "string"
			},
			"p_SourcePathPattern": {
				"type": "string"
			},
			"p_SourceFileFormat": {
				"type": "string"
			},
			"p_StagingTable": {
				"type": "string"
			},
			"p_FileName": {
				"type": "string"
			}
		},
		"annotations": []
	}
}