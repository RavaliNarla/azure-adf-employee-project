{
	"name": "PL_MetaDriven_ProcessEntity",
	"properties": {
		"activities": [
			{
				"name": "Copy_ADLS_to_SQL",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"additionalColumns": [
							{
								"name": "LoadTimestamp",
								"value": "@utcnow()"
							},
							{
								"name": "FileName",
								"value": "$$FILEPATH"
							}
						],
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "AzureSqlSink",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "OrderId",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "OrderId",
									"type": "Int64",
									"physicalType": "bigint"
								}
							},
							{
								"source": {
									"name": "LineNumber",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "LineNumber",
									"type": "Int32",
									"physicalType": "int"
								}
							},
							{
								"source": {
									"name": "OrderDate",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "OrderDate",
									"type": "Date",
									"physicalType": "date"
								}
							},
							{
								"source": {
									"name": "ProductId",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "ProductId",
									"type": "String",
									"physicalType": "nvarchar"
								}
							},
							{
								"source": {
									"name": "CustomerId",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "CustomerId",
									"type": "String",
									"physicalType": "nvarchar"
								}
							},
							{
								"source": {
									"name": "StoreId",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "StoreId",
									"type": "String",
									"physicalType": "nvarchar"
								}
							},
							{
								"source": {
									"name": "Quantity",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "Quantity",
									"type": "Int32",
									"physicalType": "int"
								}
							},
							{
								"source": {
									"name": "UnitPrice",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "UnitPrice",
									"type": "Decimal",
									"physicalType": "decimal",
									"scale": 4,
									"precision": 18
								}
							},
							{
								"source": {
									"name": "DiscountAmount",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "DiscountAmount",
									"type": "Decimal",
									"physicalType": "decimal",
									"scale": 4,
									"precision": 18
								}
							},
							{
								"source": {
									"name": "CostAmount",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "CostAmount",
									"type": "Decimal",
									"physicalType": "decimal",
									"scale": 4,
									"precision": 18
								}
							},
							{
								"source": {
									"name": "LoadTimestamp",
									"type": "String"
								},
								"sink": {
									"name": "LoadTimestamp",
									"type": "DateTime",
									"physicalType": "datetime2"
								}
							},
							{
								"source": {
									"name": "FileName",
									"type": "String"
								},
								"sink": {
									"name": "FileName",
									"type": "String",
									"physicalType": "nvarchar"
								}
							}
						],
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_ADLS_DynamicSource",
						"type": "DatasetReference",
						"parameters": {
							"p_SourceContainer": "@item().SourceContainer",
							"p_SourcePathPattern": "@item().SourcePathPattern",
							"p_FileName": "@item().FileName"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_SQL_SalesOrder",
						"type": "DatasetReference"
					}
				]
			}
		],
		"parameters": {
			"p_EntityId": {
				"type": "int"
			},
			"p_EntityName": {
				"type": "string"
			},
			"p_SourceContainer": {
				"type": "string"
			},
			"p_SourcePathPattern": {
				"type": "string"
			},
			"p_SourceFileFormat": {
				"type": "string"
			},
			"p_StagingTable": {
				"type": "string"
			}
		},
		"annotations": []
	}
}