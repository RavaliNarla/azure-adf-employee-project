{
	"name": "PL_MetaDriven_ProcessEntity",
	"properties": {
		"activities": [
			{
				"name": "Set_StartTime",
				"type": "SetVariable",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_StartTime",
					"value": {
						"value": "@utcnow()",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Script_PrepareLoad",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Set_StartTime",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL_MetaDB",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"parameters": [
								{
									"name": "p_StagingTable",
									"type": "String",
									"value": {
										"value": "@pipeline().parameters.p_StagingTable",
										"type": "Expression"
									},
									"direction": "Input"
								},
								{
									"name": "p_LoadType",
									"type": "String",
									"value": {
										"value": "@pipeline().parameters.p_LoadType",
										"type": "Expression"
									},
									"direction": "Input"
								}
							],
							"type": "NonQuery",
							"text": {
								"value": "@if(equals(pipeline().parameters.p_LoadType,'Full'),concat('TRUNCATE TABLE stg.',pipeline().parameters.p_StagingTable,';'),'SELECT 1;')",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "Copy_ADLS_to_SQL",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Script_PrepareLoad",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"additionalColumns": [
							{
								"name": "LoadTimestamp",
								"value": {
									"value": "@utcnow()",
									"type": "Expression"
								}
							},
							{
								"name": "FileName",
								"value": "$$FILEPATH"
							}
						],
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "AzureSqlSink",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false,
						"disableMetricsCollection": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_ADLS_DynamicSource",
						"type": "DatasetReference",
						"parameters": {
							"p_SourceContainer": "@pipeline().parameters.p_SourceContainer",
							"p_SourcePathPattern": "@pipeline().parameters.p_SourcePathPattern",
							"p_FileName": "@pipeline().parameters.p_FileName"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_SQL_DynamicTarget",
						"type": "DatasetReference",
						"parameters": {
							"p_TargetTable": {
								"value": "@pipeline().parameters.p_StagingTable",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Script_ValidateStaging",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Copy_ADLS_to_SQL",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL_MetaDB",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"parameters": [
								{
									"name": "EntityId",
									"type": "Int32",
									"value": "@pipeline().parameters.p_EntityId",
									"direction": "Input"
								},
								{
									"name": "BatchId",
									"type": "String",
									"value": "@pipeline().RunId",
									"direction": "Input"
								}
							],
							"type": "NonQuery",
							"text": {
								"value": "EXEC meta.usp_ValidateStagingData\n    @EntityId = @EntityId,\n    @BatchId = @BatchId;",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "Script_Dedup",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Script_ValidateStaging",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL_MetaDB",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"parameters": [
								{
									"name": "EntityId",
									"type": "Int32",
									"value": "@pipeline().parameters.p_EntityId",
									"direction": "Input"
								}
							],
							"type": "NonQuery",
							"text": {
								"value": "EXEC meta.usp_DeduplicateStaging @EntityId = @EntityId;",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "Script_LoadTarget",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Script_Dedup",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL_MetaDB",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "NonQuery",
							"text": {
								"value": "@if(equals(pipeline().parameters.p_EntityType,'Dimension'), concat('EXEC dw.usp_LoadDim', pipeline().parameters.p_EntityName, ';'), concat('EXEC dw.usp_LoadFact', pipeline().parameters.p_EntityName, ';'))",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "Script_AuditSuccess",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Script_LoadTarget",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL_MetaDB",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"parameters": [
								{
									"name": "BatchId",
									"type": "String",
									"value": "@pipeline().RunId",
									"direction": "Input"
								},
								{
									"name": "EntityId",
									"type": "Int32",
									"value": "@pipeline().parameters.p_EntityId",
									"direction": "Input"
								},
								{
									"name": "EntityName",
									"type": "String",
									"value": "@pipeline().parameters.p_EntityName",
									"direction": "Input"
								},
								{
									"name": "LoadType",
									"type": "String",
									"value": "@pipeline().parameters.p_LoadType",
									"direction": "Input"
								},
								{
									"name": "StartTime",
									"type": "DateTime",
									"value": "@variables('v_StartTime')",
									"direction": "Input"
								},
								{
									"name": "EndTime",
									"type": "DateTime",
									"value": "@utcnow()",
									"direction": "Input"
								},
								{
									"name": "Status",
									"type": "String",
									"value": "Success",
									"direction": "Input"
								},
								{
									"name": "ErrorMessage",
									"type": "String",
									"value": "",
									"direction": "Input"
								}
							],
							"type": "NonQuery",
							"text": "EXEC meta.usp_InsertAuditLog @BatchId=@BatchId, @EntityId=@EntityId, @EntityName=@EntityName, @LoadType=@LoadType, @StartTime=@StartTime, @EndTime=@EndTime, @Status=@Status, @ErrorMessage=@ErrorMessage;"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "Script_AuditFailure",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Script_LoadTarget",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_AzureSQL_MetaDB",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"parameters": [
								{
									"name": "BatchId",
									"type": "String",
									"value": "@pipeline().RunId",
									"direction": "Input"
								},
								{
									"name": "EntityId",
									"type": "Int32",
									"value": "@pipeline().parameters.p_EntityId",
									"direction": "Input"
								},
								{
									"name": "EntityName",
									"type": "String",
									"value": "@pipeline().parameters.p_EntityName",
									"direction": "Input"
								},
								{
									"name": "LoadType",
									"type": "String",
									"value": "@pipeline().parameters.p_LoadType",
									"direction": "Input"
								},
								{
									"name": "StartTime",
									"type": "DateTime",
									"value": "@variables('v_StartTime')",
									"direction": "Input"
								},
								{
									"name": "EndTime",
									"type": "DateTime",
									"value": "@utcnow()",
									"direction": "Input"
								},
								{
									"name": "Status",
									"type": "String",
									"value": "Failed",
									"direction": "Input"
								},
								{
									"name": "ErrorMessage",
									"type": "String",
									"value": {
										"value": "@string(activity('Script_LoadTarget').Error.Message)",
										"type": "Expression"
									},
									"direction": "Input"
								}
							],
							"type": "NonQuery",
							"text": "EXEC meta.usp_InsertAuditLog @BatchId=@BatchId, @EntityId=@EntityId, @EntityName=@EntityName, @LoadType=@LoadType, @StartTime=@StartTime, @EndTime=@EndTime, @Status=@Status, @ErrorMessage=@ErrorMessage;"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"parameters": {
			"p_EntityId": {
				"type": "int"
			},
			"p_EntityName": {
				"type": "string"
			},
			"p_EntityType": {
				"type": "string"
			},
			"p_SourceContainer": {
				"type": "string"
			},
			"p_SourcePathPattern": {
				"type": "string"
			},
			"p_SourceFileFormat": {
				"type": "string"
			},
			"p_StagingTable": {
				"type": "string"
			},
			"p_FileName": {
				"type": "string"
			},
			"p_LoadType": {
				"type": "string"
			},
			"p_TargetSchema": {
				"type": "string"
			},
			"p_TargetTable": {
				"type": "string"
			}
		},
		"variables": {
			"v_StartTime": {
				"type": "String"
			}
		},
		"annotations": []
	}
}
