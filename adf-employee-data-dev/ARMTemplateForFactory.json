{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-employee-data-dev"
		},
		"AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1'"
		},
		"LS_ADLS_DataLake_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_DataLake'"
		},
		"LS_ADLS_Target_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_Target'"
		},
		"LS_AzureSQL_Employee_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AzureSQL_Employee'"
		},
		"LS_AzureSQL_MetaDB_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AzureSQL_MetaDB'"
		},
		"LS_AzureSQL_Source_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AzureSQL_Source'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stdataengdev12345.dfs.core.windows.net/"
		},
		"LS_ADLS_DataLake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://projectmetadriven.dfs.core.windows.net/"
		},
		"LS_ADLS_Target_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://metaproject2026.dfs.core.windows.net/"
		},
		"LS_AzureSQL_Employee_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-employee-data-12345.database.windows.net"
		},
		"LS_AzureSQL_Employee_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "empdb"
		},
		"LS_AzureSQL_Employee_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adminuser"
		},
		"LS_AzureSQL_MetaDB_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-employee-data-12345.database.windows.net"
		},
		"LS_AzureSQL_MetaDB_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "metadb"
		},
		"LS_AzureSQL_MetaDB_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adminuser"
		},
		"LS_AzureSQL_Source_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-employee-data-12345.database.windows.net"
		},
		"LS_AzureSQL_Source_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "metadb"
		},
		"LS_AzureSQL_Source_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adminuser"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/PL_MetaDriven_Master')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Lookup_ActiveEntities",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": "SELECT\n    EntityId,\n    EntityName,\n    EntityType,\n    SourceContainer,\n    SourcePathPattern,\n    SourceFileFormat,\n    FileName,\n    StagingTable,\n    TargetSchema,\n    TargetTable,\n    LoadType,\n    BusinessKeyColumns,\n    WatermarkColumn\nFROM meta.EntityConfig\nWHERE IsActive = 1\nORDER BY Priority;",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_SQL_EntityConfig",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "ForEach_Entity",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "Lookup_ActiveEntities",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('Lookup_ActiveEntities').output.value",
								"type": "Expression"
							},
							"isSequential": true,
							"activities": [
								{
									"name": "Execute_ProcessEntity",
									"type": "ExecutePipeline",
									"dependsOn": [],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "PL_MetaDriven_ProcessEntity",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"p_EntityId": {
												"value": "@item().EntityId",
												"type": "Expression"
											},
											"p_EntityName": {
												"value": "@item().EntityName",
												"type": "Expression"
											},
											"p_EntityType": {
												"value": "@item().EntityType",
												"type": "Expression"
											},
											"p_SourceContainer": {
												"value": "@item().SourceContainer",
												"type": "Expression"
											},
											"p_SourcePathPattern": {
												"value": "@item().SourcePathPattern",
												"type": "Expression"
											},
											"p_SourceFileFormat": {
												"value": "@item().SourceFileFormat",
												"type": "Expression"
											},
											"p_StagingTable": {
												"value": "@item().StagingTable",
												"type": "Expression"
											},
											"p_FileName": {
												"value": "@item().FileName",
												"type": "Expression"
											},
											"p_LoadType": {
												"value": "@item().LoadType",
												"type": "Expression"
											},
											"p_TargetSchema": {
												"value": "@item().TargetSchema",
												"type": "Expression"
											},
											"p_TargetTable": {
												"value": "@item().TargetTable",
												"type": "Expression"
											}
										}
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_SQL_EntityConfig')]",
				"[concat(variables('factoryId'), '/pipelines/PL_MetaDriven_ProcessEntity')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/PL_MetaDriven_ProcessEntity')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Set_StartTime",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "v_StartTime",
							"value": {
								"value": "@utcnow()",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Script_PrepareLoad",
						"type": "Script",
						"dependsOn": [
							{
								"activity": "Set_StartTime",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "LS_AzureSQL_MetaDB",
							"type": "LinkedServiceReference"
						},
						"typeProperties": {
							"scripts": [
								{
									"parameters": [
										{
											"name": "p_StagingTable",
											"type": "String",
											"value": {
												"value": "@pipeline().parameters.p_StagingTable",
												"type": "Expression"
											},
											"direction": "Input"
										},
										{
											"name": "p_LoadType",
											"type": "String",
											"value": {
												"value": "@pipeline().parameters.p_LoadType",
												"type": "Expression"
											},
											"direction": "Input"
										}
									],
									"type": "NonQuery",
									"text": {
										"value": "@if(equals(pipeline().parameters.p_LoadType,'Full'),concat('TRUNCATE TABLE stg.',pipeline().parameters.p_StagingTable,';'),'SELECT 1;')",
										"type": "Expression"
									}
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					},
					{
						"name": "Copy_ADLS_to_SQL",
						"type": "Copy",
						"dependsOn": [
							{
								"activity": "Script_PrepareLoad",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "DelimitedTextSource",
								"additionalColumns": [
									{
										"name": "LoadTimestamp",
										"value": {
											"value": "@utcnow()",
											"type": "Expression"
										}
									},
									{
										"name": "FileName",
										"value": "$$FILEPATH"
									}
								],
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "DelimitedTextReadSettings"
								}
							},
							"sink": {
								"type": "AzureSqlSink",
								"writeBehavior": "insert",
								"sqlWriterUseTableLock": false,
								"disableMetricsCollection": false
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "DS_ADLS_DynamicSource",
								"type": "DatasetReference",
								"parameters": {
									"p_SourceContainer": "@pipeline().parameters.p_SourceContainer",
									"p_SourcePathPattern": "@pipeline().parameters.p_SourcePathPattern",
									"p_FileName": "@pipeline().parameters.p_FileName"
								}
							}
						],
						"outputs": [
							{
								"referenceName": "DS_SQL_DynamicTarget",
								"type": "DatasetReference",
								"parameters": {
									"p_TargetTable": {
										"value": "@pipeline().parameters.p_StagingTable",
										"type": "Expression"
									}
								}
							}
						]
					},
					{
						"name": "Script_ValidateStaging",
						"type": "Script",
						"dependsOn": [
							{
								"activity": "Copy_ADLS_to_SQL",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "LS_AzureSQL_MetaDB",
							"type": "LinkedServiceReference"
						},
						"typeProperties": {
							"scripts": [
								{
									"parameters": [
										{
											"name": "EntityId",
											"type": "Int32",
											"value": {
												"value": "@pipeline().parameters.p_EntityId",
												"type": "Expression"
											},
											"direction": "Input"
										},
										{
											"name": "BatchId",
											"type": "String",
											"value": {
												"value": "@pipeline().RunId",
												"type": "Expression"
											},
											"direction": "Input"
										}
									],
									"type": "NonQuery",
									"text": {
										"value": "EXEC meta.usp_ValidateStagingData\n    @EntityId = @EntityId,\n    @BatchId = @BatchId;",
										"type": "Expression"
									}
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					},
					{
						"name": "Script_Dedup",
						"type": "Script",
						"dependsOn": [
							{
								"activity": "Script_ValidateStaging",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "LS_AzureSQL_MetaDB",
							"type": "LinkedServiceReference"
						},
						"typeProperties": {
							"scripts": [
								{
									"parameters": [
										{
											"name": "EntityId",
											"type": "Int32",
											"value": {
												"value": "@pipeline().parameters.p_EntityId",
												"type": "Expression"
											},
											"direction": "Input"
										}
									],
									"type": "NonQuery",
									"text": {
										"value": "EXEC meta.usp_DeduplicateStaging @EntityId = @EntityId;",
										"type": "Expression"
									}
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					},
					{
						"name": "Script_LoadTarget",
						"type": "Script",
						"dependsOn": [
							{
								"activity": "Script_Dedup",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "LS_AzureSQL_MetaDB",
							"type": "LinkedServiceReference"
						},
						"typeProperties": {
							"scripts": [
								{
									"type": "NonQuery",
									"text": {
										"value": "@if(equals(pipeline().parameters.p_EntityType,'Dimension'), concat('EXEC dw.usp_LoadDim', pipeline().parameters.p_EntityName, ';'), concat('EXEC dw.usp_LoadFact', pipeline().parameters.p_EntityName, ';'))",
										"type": "Expression"
									}
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					},
					{
						"name": "Script_AuditSuccess",
						"type": "Script",
						"dependsOn": [
							{
								"activity": "Script_LoadTarget",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "LS_AzureSQL_MetaDB",
							"type": "LinkedServiceReference"
						},
						"typeProperties": {
							"scripts": [
								{
									"parameters": [
										{
											"name": "BatchId",
											"type": "String",
											"value": {
												"value": "@pipeline().RunId",
												"type": "Expression"
											},
											"direction": "Input"
										},
										{
											"name": "EntityId",
											"type": "Int32",
											"value": {
												"value": "@pipeline().parameters.p_EntityId",
												"type": "Expression"
											},
											"direction": "Input"
										},
										{
											"name": "EntityName",
											"type": "String",
											"value": {
												"value": "@pipeline().parameters.p_EntityName",
												"type": "Expression"
											},
											"direction": "Input"
										},
										{
											"name": "LoadType",
											"type": "String",
											"value": {
												"value": "@pipeline().parameters.p_LoadType",
												"type": "Expression"
											},
											"direction": "Input"
										},
										{
											"name": "StartTime",
											"type": "DateTime",
											"value": {
												"value": "@variables('v_StartTime')",
												"type": "Expression"
											},
											"direction": "Input"
										},
										{
											"name": "EndTime",
											"type": "DateTime",
											"value": {
												"value": "@utcnow()",
												"type": "Expression"
											},
											"direction": "Input"
										},
										{
											"name": "Status",
											"type": "String",
											"value": "Success",
											"direction": "Input"
										},
										{
											"name": "ErrorMessage",
											"type": "String",
											"value": "",
											"direction": "Input"
										}
									],
									"type": "NonQuery",
									"text": "EXEC meta.usp_InsertAuditLog @BatchId=@BatchId, @EntityId=@EntityId, @EntityName=@EntityName, @LoadType=@LoadType, @StartTime=@StartTime, @EndTime=@EndTime, @Status=@Status, @ErrorMessage=@ErrorMessage;"
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					},
					{
						"name": "Script_AuditFailure",
						"type": "Script",
						"dependsOn": [
							{
								"activity": "Script_LoadTarget",
								"dependencyConditions": [
									"Failed"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "LS_AzureSQL_MetaDB",
							"type": "LinkedServiceReference"
						},
						"typeProperties": {
							"scripts": [
								{
									"parameters": [
										{
											"name": "BatchId",
											"type": "String",
											"value": {
												"value": "@pipeline().RunId",
												"type": "Expression"
											},
											"direction": "Input"
										},
										{
											"name": "EntityId",
											"type": "Int32",
											"value": {
												"value": "@pipeline().parameters.p_EntityId",
												"type": "Expression"
											},
											"direction": "Input"
										},
										{
											"name": "EntityName",
											"type": "String",
											"value": {
												"value": "@pipeline().parameters.p_EntityName",
												"type": "Expression"
											},
											"direction": "Input"
										},
										{
											"name": "LoadType",
											"type": "String",
											"value": {
												"value": "@pipeline().parameters.p_LoadType",
												"type": "Expression"
											},
											"direction": "Input"
										},
										{
											"name": "StartTime",
											"type": "DateTime",
											"value": {
												"value": "@variables('v_StartTime')",
												"type": "Expression"
											},
											"direction": "Input"
										},
										{
											"name": "EndTime",
											"type": "DateTime",
											"value": {
												"value": "@utcnow()",
												"type": "Expression"
											},
											"direction": "Input"
										},
										{
											"name": "Status",
											"type": "String",
											"value": "Failed",
											"direction": "Input"
										},
										{
											"name": "ErrorMessage",
											"type": "String",
											"value": {
												"value": "@string(activity('Script_LoadTarget').Error.Message)",
												"type": "Expression"
											},
											"direction": "Input"
										}
									],
									"type": "NonQuery",
									"text": "EXEC meta.usp_InsertAuditLog @BatchId=@BatchId, @EntityId=@EntityId, @EntityName=@EntityName, @LoadType=@LoadType, @StartTime=@StartTime, @EndTime=@EndTime, @Status=@Status, @ErrorMessage=@ErrorMessage;"
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"p_EntityId": {
						"type": "int"
					},
					"p_EntityName": {
						"type": "string"
					},
					"p_EntityType": {
						"type": "string"
					},
					"p_SourceContainer": {
						"type": "string"
					},
					"p_SourcePathPattern": {
						"type": "string"
					},
					"p_SourceFileFormat": {
						"type": "string"
					},
					"p_StagingTable": {
						"type": "string"
					},
					"p_FileName": {
						"type": "string"
					},
					"p_LoadType": {
						"type": "string"
					},
					"p_TargetSchema": {
						"type": "string"
					},
					"p_TargetTable": {
						"type": "string"
					}
				},
				"variables": {
					"v_StartTime": {
						"type": "String"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_AzureSQL_MetaDB')]",
				"[concat(variables('factoryId'), '/datasets/DS_ADLS_DynamicSource')]",
				"[concat(variables('factoryId'), '/datasets/DS_SQL_DynamicTarget')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/PL_MetadataDriven_Load')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
