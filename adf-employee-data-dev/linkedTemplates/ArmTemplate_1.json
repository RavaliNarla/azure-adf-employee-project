		{
			"name": "[concat(parameters('factoryName'), '/PL_MetaDriven_Master')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Lookup_ActiveEntities",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": "SELECT\n    EntityId,\n    EntityName,\n    SourceContainer,\n    SourcePathPattern,\n    SourceFileFormat,\n    FileName,\n    StagingTable,\n    TargetSchema,\n    TargetTable,\n    LoadType,\n    BusinessKeyColumns,\n    WatermarkColumn\nFROM meta.EntityConfig\nWHERE IsActive = 1\nORDER BY Priority;",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_SQL_EntityConfig",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "ForEach_Entity",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "Lookup_ActiveEntities",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('Lookup_ActiveEntities').output.value",
								"type": "Expression"
							},
							"isSequential": false,
							"activities": [
								{
									"name": "Execute_ProcessEntity",
									"type": "ExecutePipeline",
									"dependsOn": [],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "PL_MetaDriven_ProcessEntity",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"p_EntityId": {
												"value": "@item().EntityId",
												"type": "Expression"
											},
											"p_EntityName": {
												"value": "@item().EntityName",
												"type": "Expression"
											},
											"p_SourceContainer": {
												"value": "@item().SourceContainer",
												"type": "Expression"
											},
											"p_SourcePathPattern": {
												"value": "@item().SourcePathPattern",
												"type": "Expression"
											},
											"p_SourceFileFormat": {
												"value": "@item().SourceFileFormat",
												"type": "Expression"
											},
											"p_StagingTable": {
												"value": "@item().StagingTable",
												"type": "Expression"
											},
											"p_FileName": {
												"value": "@item().FileName",
												"type": "Expression"
											},
											"p_LoadType": {
												"value": "@item().LoadType",
												"type": "Expression"
											},
											"p_TargetSchema": {
												"value": "@item().TargetSchema",
												"type": "Expression"
											},
											"p_TargetTable": {
												"value": "@item().TargetTable",
												"type": "Expression"
											}
										}
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": []
		}
	]
